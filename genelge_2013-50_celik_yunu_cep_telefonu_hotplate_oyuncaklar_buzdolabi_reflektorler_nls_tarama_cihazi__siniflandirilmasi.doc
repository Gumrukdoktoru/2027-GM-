	mso-fareast-font-family:"Courier New";
	color:black;}
p.MsoHeader, li.MsoHeader, div.MsoHeader
	{mso-style-unhide:no;
	margin:0cm;
	mso-pagination:none;
	tab-stops:center 8.0cm right 16.0cm;
	font-size:12.0pt;
	font-family:"Courier New";
	mso-fareast-font-family:"Courier New";
	color:black;}
p.MsoFooter, li.MsoFooter, div.MsoFooter
	{mso-style-unhide:no;
	margin:0cm;
	mso-pagination:none;
	tab-stops:center 8.0cm right 16.0cm;
