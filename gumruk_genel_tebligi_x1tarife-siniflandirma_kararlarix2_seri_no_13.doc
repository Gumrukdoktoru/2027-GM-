 .25pt dotted windowtext;mso-border-insidev:.25pt dotted windowtext'>
 <tr style='mso-yfti-irow:0;mso-yfti-firstrow:yes'>
  <td width=326 style='width:175.2pt;border:dotted windowtext 1.0pt;mso-border-alt:
  dotted windowtext .25pt;padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal align=center style='margin-bottom:0cm;margin-bottom:.0001pt;
  text-align:center;line-height:normal'><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Eşyanın Tanımı<o:p></o:p></span></b></p>
  </td>
  <td width=192 style='width:103.3pt;border:dotted windowtext 1.0pt;border-left:
  none;mso-border-left-alt:dotted windowtext .25pt;mso-border-alt:dotted windowtext .25pt;
  padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal align=center style='margin-bottom:0cm;margin-bottom:.0001pt;
  text-align:center;line-height:normal'><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Sınıflandırma(KNkodu)<o:p></o:p></span></b></p>
  </td>
  <td width=391 style='width:210.15pt;border:dotted windowtext 1.0pt;
  border-left:none;mso-border-left-alt:dotted windowtext .25pt;mso-border-alt:
  dotted windowtext .25pt;padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal align=center style='margin-bottom:0cm;margin-bottom:.0001pt;
  text-align:center;line-height:normal'><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Gerekçeler<o:p></o:p></span></b></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:1'>
  <td width=326 valign=top style='width:175.2pt;border:dotted windowtext 1.0pt;
  border-top:none;mso-border-top-alt:dotted windowtext .25pt;mso-border-alt:
  dotted windowtext .25pt;padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Ürün,
  aromatik, ot-benzeri kokusu ve acı, otsu tadı olan; berrak, koyu kahverengi
  bir sıvıdan oluşur. Hakiki alkol derecesi hacim olarak, %43'tür.<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Ürün,
  32 çeşit şifalı bitki özünün karamel özü, su ve alkol (Hacimce %96 alkol) ile
  karışımını içerir. Bileşime giren diğer maddeler yanında, aşağıda belirtilen
  maddeler de, ürünün yapımında kullanılmıştır.<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpFirst style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l7 level1 lfo1'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l7 level1 lfo1'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Zedoary
  (<i style='mso-bidi-font-style:normal'>Radix Zedoariae</i>)<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l7 level1 lfo1'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Manna
  (<i style='mso-bidi-font-style:normal'>Manna</i>)<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l7 level1 lfo1'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Melek
  otu kökü (<i style='mso-bidi-font-style:normal'>Radix Angelicae</i>)<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l7 level1 lfo1'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Carline
  kökü (<i style='mso-bidi-font-style:normal'>Radix Carlinae</i>)<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l7 level1 lfo1'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Mir
  (<i style='mso-bidi-font-style:normal'>Myrrha</i>)<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l7 level1 lfo1'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Kafur
  (<i style='mso-bidi-font-style:normal'>Camphora</i>)<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpLast style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l7 level1 lfo1'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Safran
  (<i style='mso-bidi-font-style:normal'>Flos Croci</i>)<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Ambalajlanmasına
  göre, ürünün küçük miktarlarda (akşam ve sabah bir kaşık; su, çay veya meyve
  suyu ile karıştırılması mümkündür) alınması tavsiye edilmektedir.<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>500-ml'lik
  şişelere konulan ürün, içecek olarak doğrudan tüketilebilir.<o:p></o:p></span></p>
  </td>
  <td width=192 valign=top style='width:103.3pt;border-top:none;border-left:
  none;border-bottom:dotted windowtext 1.0pt;border-right:dotted windowtext 1.0pt;
  mso-border-top-alt:dotted windowtext .25pt;mso-border-left-alt:dotted windowtext .25pt;
  mso-border-alt:dotted windowtext .25pt;padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal align=center style='margin-bottom:0cm;margin-bottom:.0001pt;
  text-align:center;line-height:normal'><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:"Times New Roman","serif"'><a
  data-tooltip='22#P2208' target='_blank' href="https://www.gumrukkulliyati.com/index.php?id=docs/gumruk_mevzuati/dosyalar/tarife_ve_izahname/izahname/fasil_metinleri/22.htm#p2208">2208.90.69</a><o:p></o:p></span></b></p>
  </td>
  <td width=391 valign=top style='width:210.15pt;border-top:none;border-left:
  none;border-bottom:dotted windowtext 1.0pt;border-right:dotted windowtext 1.0pt;
  mso-border-top-alt:dotted windowtext .25pt;mso-border-left-alt:dotted windowtext .25pt;
  mso-border-alt:dotted windowtext .25pt;padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Sınıflandırma,
  Genel Yorum Kuralları 1 ve 6, 30. Fasıl Ek Notu 1 (b), ve 2208, 2208 90 ve
  2208 90 69 KN kodlarının lafzına dayanılarak belirlenmiştir.<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Ürün
  30. Fasıl içinde tedavide kullanılan madde olarak addedilemez. Etiket,
  beraberindeki kullanım kılavuzu ve de paket, etkin maddenin(lerin) tip ve
  oranlarıyla ilgili bilgi içermemektedir. Sadece kullanılan bitkilerin veya
  bitki bölümlerinin miktar ve tür bilgilerinden söz edilmiştir. 30. Fasıl Ek
  Notu 1 (b) de belirtilen şartlar, bu nedenle karşılanmamaktadır.<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Ürün,
  gıda desteği olma, genel sağlığın ve sıhhatin korunması amacıyla üretilmiş
  olma, bitki özlerine dayanma özelliklerini taşıyan,<span
  style='mso-spacerun:yes'>   </span>2208 pozisyonunda yer alan alkollü
  içeceklerdendir (bkz. 2208. Fasıl'a ilişkin armonize Sistem Açıklama Notu,
  üçüncü paragraf, madde 16).<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:2'>
  <td width=326 valign=top style='width:175.2pt;border:dotted windowtext 1.0pt;
  border-top:none;mso-border-top-alt:dotted windowtext .25pt;mso-border-alt:
  dotted windowtext .25pt;padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoListParagraphCxSpFirst style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;line-height:normal'><span
  style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Aşağıdakilerden
  oluşan, perakende satışa yönelik tuvalet eşyası takımı:<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;line-height:normal'><span
  style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l12 level1 lfo2'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>bardak,<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l12 level1 lfo2'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>sabunluk,<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l12 level1 lfo2'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>silindir
  şeklinde diş fırçalık, ve<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpMiddle style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;text-indent:-18.0pt;line-height:normal;
  mso-list:l12 level1 lfo2'><![if !supportLists]><span style='font-size:9.0pt;
  mso-bidi-font-family:Calibri'><span style='mso-list:Ignore'>-<span
  style='font:7.0pt "Times New Roman"'>         
  </span></span></span><![endif]><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>sıvı
  sabunluk.<o:p></o:p></span></p>
  <p class=MsoListParagraphCxSpLast style='margin:0cm;margin-bottom:.0001pt;
  mso-add-space:auto;text-align:justify;line-height:normal'><span
  style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Sıvı
  sabunluk, plastik pompalı seramik hazneden oluşmaktadır. Takımın diğer
  parçaları da seramikten yapılmıştır.<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>Tüm
  parçaların tasarımı aynı olup, tuvalet eşyası olarak kullanım içindirler.<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'>(Fotoğrafa
  <a href="#resim1">bakınız</a>)<span style='mso-spacerun:yes'>  </span>(1)<o:p></o:p></span></p>
  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:9.0pt;font-family:"Times New Roman","serif"'><o:p> </o:p></span></p>
  </td>
  <td width=192 valign=top style='width:103.3pt;border-top:none;border-left:
  none;border-bottom:dotted windowtext 1.0pt;border-right:dotted windowtext 1.0pt;
  mso-border-top-alt:dotted windowtext .25pt;mso-border-left-alt:dotted windowtext .25pt;
  mso-border-alt:dotted windowtext .25pt;padding:0cm 5.4pt 0cm 5.4pt'>
  <p class=MsoNormal align=center style='margin-bottom:0cm;margin-bottom:.0001pt;
  text-align:center;line-height:normal'><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:"Times New Roman","serif"'><a
  data-tooltip='69#p6912' target='_blank' href="https://www.gumrukkulliyati.com/index.php?id=docs/gumruk_mevzuati/dosyalar/tarife_ve_izahname/izahname/fasil_metinleri/69.htm#p6912">6912.00.50</a><o:p></o:p></span></b></p>
  </td>
  <td width=391 valign=top style='width:210.15pt;border-top:none;border-left:
  none;border-bottom:dotted windowtext 1.0pt;border-right:dotted windowtext 1.0pt;
  mso-border-top-alt:dotted windowtext .25pt;mso-border-left-alt:dotted windowtext .25pt;
